{
	"compilerOptions": {
        "module": "esnext",
        "target": "es2022",
        "moduleResolution": "bundler",
		"baseUrl": ".",
		"rootDir": "./src",
		"alwaysStrict": true,
		"noEmit": true,
        "noImplicitAny": true,
		"paths": {
			"#src/*": ["src/*"]
		},
	},
	"include": ["src/**/*"],
    "exclude": ["locales", "scripts"]
}
