{
  "name": "quaver",
  "version": "8.0.0-next.1",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.0",
    "@keyv/sqlite": "^4.0.6",
    "@lavaclient/plugin-effects": "^1.0.0-rc.2",
    "@lavaclient/plugin-queue": "^0.0.1",
    "@zptxdev/zptx-lib": "^1.1.0",
    "cache-manager": "^7.2.5",
    "cacheable": "^2.2.0",
    "crypto-js": "^4.2.0",
    "discord.js": "^14.24.2",
    "express": "^5.1.0",
    "hangul-romanization": "^1.0.1",
    "keyv": "^5.5.4",
    "lavaclient": "^5.0.0-rc.3",
    "lavalink-protocol": "^1.1.1",
    "lavalink-ws-client": "^1.0.2",
    "lodash-es": "^4.17.21",
    "pinyin-pro": "^3.27.0",
    "socket.io": "^4.8.1",
    "undici": "^7.16.0",
    "wanakana": "^5.3.1",
    "winston": "^3.18.3",
    "winston-loki": "^6.1.3",
    "yocto-spinner": "^1.0.0",
    "yoctocolors": "^2.1.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.5",
    "@types/lodash-es": "^4.17.12",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "fast-glob": "^3.3.3",
    "genversion": "^3.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.0",
    "tsdown": "^0.16.5",
    "typescript": "^5.9.3"
  },
  "main": "dist/main.mjs",
  "scripts": {
    "slash:register:global": "bun run scripts/register-global-commands.js",
    "slash:register:guild": "bun run scripts/register-guild-commands.js",
    "slash:delete:global": "bun run scripts/delete-global-commands.js",
    "slash:delete:guild": "bun run scripts/delete-guild-commands.js",
    "migrate": "bun run scripts/migrate.js",
    "build": "rimraf dist/ && genversion --es6 --semi src/lib/util/version.ts && tsdown",
    "start": "bun run .",
    "dev": "bun run --enable-source-maps .",
    "lint": "eslint . --ext .ts"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "release": {
    "tagFormat": "${version}",
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "package-lock.json"
          ],
          "message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "trustedDependencies": [
    "protobufjs"
  ],
  "patchedDependencies": {
    "keyv@5.5.4": "patches/keyv@5.5.4.patch",
    "@lavaclient/plugin-queue@0.0.1": "patches/@lavaclient__plugin-queue@0.0.1.patch",
    "winston-loki@6.1.3": "patches/winston-loki@6.1.3.patch"
  }
}
